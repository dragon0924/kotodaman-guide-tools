{
  "name": "kotodaman-guide-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "check:public": "node scripts/check-public-content.mjs",
    "verify": "npm run check:public && npm test && npm run typecheck && npm run lint",
    "demo:reset": "node scripts/create-sample-data.mjs --confirm-reset",
    "setup:local-admin": "node scripts/setup-local-admin.mjs",
    "export:public": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/exportPublicContent.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "postcss": "8.5.30",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.60.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "description": "Portfolio snapshot with synthetic data; unofficial local-first strategy authoring tools",
  "engines": {
    "node": ">=24 <25"
  }
}
